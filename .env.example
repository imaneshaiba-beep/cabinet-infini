# Accès FTP de ce projet. Jamais commité, jamais déployé.
# Copier ce fichier en « .env » et le remplir : npm run deployer le lit.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# true : FTP chiffré (FTPS), à garder sauf si l'hébergeur ne le permet pas
FTP_SECURE=true
# Le dossier du site sur le serveur, par exemple /cabinet-infini
REMOTE_DIR=
# L'adresse publique du site, affichée à la fin de l'envoi
PUBLIC_URL=
# Le dossier à envoyer ; vide = dist
LOCAL_DIR=
